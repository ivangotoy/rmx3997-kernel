# Pinned maxsteeel NoMount diagnostic integration; built-in ownership only.
config NOMOUNT
    bool "NoMount ext4 regular-file diagnostic redirection"
    depends on KEYS && EXT4_FS=y
    default n
    help
      Paired add_key NoMount protocol. This bounded integration supports only
      regular files below existing writable ext4 directories on the same
      filesystem. Other rule kinds/filesystems fail with EOPNOTSUPP.
